[Unit]
Description=WAPALA email outbox delivery
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=wapala
Group=wapala
WorkingDirectory=/srv/wapala/current
EnvironmentFile=/etc/wapala/production.env
ExecStart=/usr/bin/node --import tsx --conditions=react-server scripts/email-worker.ts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
