APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/wapala
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/wapala_test
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECURITY_KEY=
# Vercel initial Super User setup only: 32 random bytes, base64url (43 characters).
# Keep the real value in Vercel Secret Environment Variables, never in Git.
# Optional for the existing CLI flow; remove after successful setup.
# INITIAL_SETUP_TOKEN=
WAPALA_MODE=backend
TRUST_PROXY=false
EMAIL_MODE=sink
# Production worker: EMAIL_MODE=smtp. Never put real credentials in this template.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
