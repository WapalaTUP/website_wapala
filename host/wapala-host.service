[Unit]
Description=WAPALA Next.js application (host deploy)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=wapala
Group=wapala
WorkingDirectory=/srv/wapala/current
EnvironmentFile=/etc/wapala/production.env
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wapala/media /srv/wapala/current/.next
MemoryAccounting=true
# Sesuaikan dengan RAM VPS; lihat README bagian kapasitas.
MemoryMax=900M
TasksMax=128

[Install]
WantedBy=multi-user.target
